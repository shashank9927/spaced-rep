# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required only by scripts/import-catalog.mjs.
SUPABASE_SERVICE_ROLE_KEY=

# Lowercase email address of the first app administrator.
BOOTSTRAP_ADMIN_EMAIL=

# Add this URL to Supabase Auth > URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
